# NewsGraber Configuration
# Copy this file to .env and modify as needed

# Database path (default: newsgraber.db)
# NEWSGRABER_DB_PATH=newsgraber.db

# HTTP timeout per source in seconds (default: 15)
# NEWSGRABER_FETCH_TIMEOUT=15

# Max concurrent HTTP requests (default: 10)
# NEWSGRABER_FETCH_CONCURRENCY=10

# Web server settings
# NEWSGRABER_HOST=0.0.0.0
# NEWSGRABER_PORT=8000

# Filter by language (empty = all)
# NEWSGRABER_DEFAULT_LANGUAGE=

# Max articles per RSS source (default: 20)
# NEWSGRABER_MAX_ARTICLES_PER_SOURCE=20
